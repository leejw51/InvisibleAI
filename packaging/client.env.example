# Capture client only. Copy this file to .env beside go.sh and fill in what you need.
# go.sh reads only the keys below; nothing in this file is executed.
# Values baked into go.sh (Dashboard downloads) and variables already exported in
# your shell take precedence. Anything left empty is asked for at launch.
# Write plain KEY=value lines: no quotes, no spaces around "=".

# The backend's Tailscale address, including its port.
BACKEND_URL=

# The owner wallet address shown on the backend Dashboard. Never a recovery phrase.
OWNER_WALLET=

# The node token the backend owner gave you, if their backend sets APP_TOKEN.
# Keep this file private (chmod 600 .env) when you store a token here.
APP_TOKEN=

# Where the client keeps its settings and device key (default ~/.causewaybaybotclient).
# CAUSEWAYBAY_CLIENT_CONFIG_DIR=
