# Backend only. Copy this file to .env. Cloud provider keys are optional for local AI.
# The server loads .env from its working directory, then ~/.causewaybaybot/.env
# (or --config-dir/.env). Existing environment variables always take precedence.
# Restart the backend after changes. Never commit your real .env file.

# Grok / xAI — automatically selected when this is the only configured provider.
XAI_API_KEY=

# Optional alternative providers. Leave unused keys commented out.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Permanent owner wallet. Enables mnemonic login and registration approval.
# Other admins can be designated in Admin → Approved users. Never put a mnemonic here.
CWBBOT_ADMIN=

# Optional remote-access token (16+ URL-safe characters); required for non-loopback binding.
# Local capture uses a generated private capture-token file automatically.
# A node token never grants browser/admin access when CWBBOT_ADMIN is set.
# Set the same APP_TOKEN in the capture CLI's environment when enabled.
# APP_TOKEN=

# Optional backend settings (CLI flags and exported variables take precedence).
# BIND_ADDR=127.0.0.1:3000
# SEMANTIC_SEARCH=off
# DATA_DIR=/absolute/path/to/data        # default: <config dir>/data
# DIST_DIR=/absolute/path/to/dist        # built web assets; default: dist beside the installed bin folder
# DEMO_MODE=1                            # fixture answers, no provider calls (tests only)

# Optional local workers. Enable providers in Backend settings after installing them.
# Apple worker: make apple-ai (compatible macOS and Apple Intelligence required).
# INVISIBLE_APPLE_WORKER=/absolute/path/to/bin/invisible-apple-ai
# INVISIBLE_MLX_PYTHON=/absolute/path/to/venv/bin/python
# INVISIBLE_WHISPER_WORKER=/absolute/path/to/scripts/local-ai/transcribe.py
# See docs/invisible-ai.md for explicit model/language setup and offline behavior.
